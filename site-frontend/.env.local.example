# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca é commitado (já está no .gitignore).

# Usuário administrador do painel (/admin).
ADMIN_USERNAME=admin

# Hash da senha do administrador — nunca coloque a senha em texto puro aqui.
# Gere com: npm run admin:hash-password -- "sua-senha-aqui"
# IMPORTANTE: o comando acima já devolve o valor com os "$" escapados como
# "\$" — cole exatamente como veio. Sem isso, o Next.js interpreta "$algo"
# como referência a outra variável e trunca o hash silenciosamente.
ADMIN_PASSWORD_HASH=

# Chave usada para assinar a sessão do painel. Gere uma com:
# openssl rand -base64 32
SESSION_SECRET=
